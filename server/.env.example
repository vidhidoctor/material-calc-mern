# Copy to server/.env and fill in. server/.env is git-ignored — never commit it.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/material-calc?retryWrites=true&w=majority

PORT=4000
NODE_ENV=development
# local (your PC), uat (test website) or production (live site). Shown in the header; production hides the reset-link shortcut.
APP_ENV=local

# Frontend origin(s) allowed by CORS, comma-separated.
CORS_ORIGIN=http://localhost:5173

# First Admin user, created at API start (or `npm run seed`) when missing; existing passwords are never overwritten.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
